<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Unity-independent EditMode tests outside Unity. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>PureTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PureLib/PureLib.csproj" />
    <Compile Include="../../Assets/NatsunekoLaboratory/AssetExplorer.Tests/Core/**/*.cs" />
  </ItemGroup>
</Project>
